{
  "enable_tasks_processing": true,
  "tasks_httprequests": [],
  "tasks_commands": [
    {
      "enabled": true,
      "name": "flash y sonido",
      "event": [
        "capture_still"
      ],
      "filter_mediaitem_types": [],
      "delay_before": 0,
      "wait_until_completed": false,
      "timeout": 5,
      "command": "/home/admin/bin/foto-efectos.sh"
    },
    {
      "enabled": true,
      "name": "cuenta atrás con voz (móvil)",
      "event": [
        "counting"
      ],
      "filter_mediaitem_types": [],
      "delay_before": 0,
      "wait_until_completed": false,
      "timeout": 5,
      "command": "/home/admin/bin/foto-efectos.sh cuenta {mediaitem_type}"
    },
    {
      "enabled": true,
      "name": "imprimir automático",
      "event": [
        "finished"
      ],
      "filter_mediaitem_types": [
        "image"
      ],
      "delay_before": 0,
      "wait_until_completed": false,
      "timeout": 20,
      "command": "/home/admin/bin/imprimir-foto.sh auto"
    }
  ]
}
